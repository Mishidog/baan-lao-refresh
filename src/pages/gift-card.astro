---
import Base from '../layouts/Base.astro';
---
<Base
  title="Baan Lao Website"
  description="Recognized as Canada's Best Restaurant in 2024 by the World Culinary Awards, Baan Lao combines authentic Royal Thai flavors with modern culinary artistry in an intimate waterfront setting."
>
  <div class="gift-band">
    <div class="wrap">
      <h1>Baan Lao Gift Cards</h1>
      <p class="muted">To Redeem, reservations must be made directly with the restaurant.</p>
    </div>
  </div>
  <div class="wrap widget">
    <div class="gift-up-target" data-site-id="3fea47f0-733d-42d1-cf25-08de4d4296c7" data-platform="Other"></div>
    <script is:inline>
      (function (g, i, f, t, u, p, s) {
        g[u] = g[u] || function () { (g[u].q = g[u].q || []).push(arguments); };
        p = i.createElement(f);
        p.async = 1;
        p.src = t;
        s = i.getElementsByTagName(f)[0];
        s.parentNode.insertBefore(p, s);
      })(window, document, "script", "https://cdn.giftup.app/dist/gift-up.js", "giftup");
    </script>
  </div>
</Base>
